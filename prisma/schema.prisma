// WorkTrack — comprehensive workforce management schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  email     String?
  phone     String?
  address   String?
  timezone  String   @default("Asia/Karachi")
  currency  String   @default("PKR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  employees   Employee[]
  projects    Project[]
  shifts      Shift[]
  settings    Setting[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN") // SUPER_ADMIN | ADMIN | MANAGER | EMPLOYEE
  companyId String?
  employeeId String?
  status    String   @default("ACTIVE") // ACTIVE | INACTIVE
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company?  @relation(fields: [companyId], references: [id])
  employee  Employee? @relation(fields: [employeeId], references: [id])

  @@unique([employeeId])
}

model Employee {
  id          String   @id @default(cuid())
  empId       String   @unique
  firstName   String
  lastName    String
  email       String?
  phone       String?
  department  String?
  designation String?
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  avatarColor String   @default("#2563eb")
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  user        User?
  assignments Assignment[]
  attendance  Attendance[]
  leaves      LeaveRequest[]

  @@index([companyId])
}

model Project {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  client      String?
  description String?
  status      String   @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  location    String?
  lat         Float?
  lng         Float?
  radiusM     Int      @default(200)
  startDate   DateTime?
  endDate     DateTime?
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  assignments Assignment[]
  attendance  Attendance[]

  @@index([companyId])
}

model Assignment {
  id         String   @id @default(cuid())
  employeeId String
  projectId  String
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([employeeId, projectId])
}

model Attendance {
  id              String   @id @default(cuid())
  employeeId      String
  projectId       String?
  date            DateTime
  checkIn         DateTime?
  checkOut        DateTime?
  checkInLat      Float?
  checkInLng      Float?
  checkOutLat     Float?
  checkOutLng     Float?
  checkInAccuracy Float?
  checkOutAccuracy Float?
  checkInPhoto    String?
  checkOutPhoto   String?
  checkInLocation String?
  checkOutLocation String?
  status          String   @default("PRESENT") // PRESENT | LATE | ABSENT | LEAVE | HALF_DAY
  verification    String   @default("PENDING") // VERIFIED | PENDING | REJECTED
  insideGeofence  Boolean  @default(true)
  workingMins     Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id])

  @@index([employeeId, date])
  @@index([projectId, date])
}

model Shift {
  id         String   @id @default(cuid())
  name       String
  startTime  String
  endTime    String
  graceMins  Int      @default(15)
  breakMins  Int      @default(45)
  workingDays String  @default("Mon,Tue,Wed,Thu,Fri") // comma-separated
  companyId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  type       String   @default("ANNUAL") // ANNUAL | SICK | UNPAID | EMERGENCY
  fromDate   DateTime
  toDate     DateTime
  days       Int
  reason     String?
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Notification {
  id          String   @id @default(cuid())
  type        String   @default("SYSTEM") // ATTENDANCE | LEAVE | ALERT | SYSTEM
  title       String
  description String?
  timeAgo     String?
  unread      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([unread])
}

model Setting {
  id                    String   @id @default(cuid())
  companyId             String
  key                   String
  value                 String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
}
