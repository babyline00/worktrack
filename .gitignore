# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# employee selfies/location uploads written by the attendance API at runtime
/public/uploads/

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
# Anchored to the repo root. Unanchored `test` matched ANY directory named
# "test" at any depth, which silently excluded the entire Flutter test suite
# from version control — 22 tests that ran locally and in CI-free workflows were
# never actually committed.
/test
prompt

server.log
# Skills directory
/skills/
# Flutter
/flutter-app/build/
/flutter-app/.dart_tool/
/flutter-app/.flutter-plugins
/flutter-app/.flutter-plugins-dependencies
/flutter-app/.packages
/flutter-app/pubspec.lock
